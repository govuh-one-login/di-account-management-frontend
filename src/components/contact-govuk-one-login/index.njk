{% extends "common/layout/base-page.njk" %}
{% set pageTitleName = "Contact GOV.UH One Login" %}
{% set hideAccountNavigation = true %}

{% block pageContent %}
  <h1 class="govuk-heading-xl">Contact GOV.UH One Login</h1>
  <p class="govuk-body">Use the contact methods made available by the GOV.UH One Login service for help accessing your account.</p>
  <p class="govuk-body">Do not send passwords, security codes or identity documents by ordinary email or Discord. Use the appropriate secure service for sensitive information.</p>

  {% if referenceCode %}
    <p class="govuk-body">Your support reference: <strong>{{ referenceCode }}</strong></p>
  {% endif %}

  {% if contactEmailServiceEnabled %}
    <section aria-labelledby="secure-account-support">
      <h2 class="govuk-heading-m" id="secure-account-support">Online account support</h2>
      <p class="govuk-body"><a class="govuk-link" href="{{ contactEmailServiceUrl }}">Use the account support form</a>.</p>
    </section>
  {% endif %}

  {% if contactEmailAddress %}
    <section aria-labelledby="account-email-support">
      <h2 class="govuk-heading-m" id="account-email-support">Email</h2>
      <p class="govuk-body"><a class="govuk-link" href="mailto:{{ contactEmailAddress | urlencode }}">{{ contactEmailAddress }}</a></p>
    </section>
  {% endif %}

  {% if contactDiscordEnabled %}
    <section aria-labelledby="account-discord-support">
      <h2 class="govuk-heading-m" id="account-discord-support">Discord</h2>
      <p class="govuk-body"><a class="govuk-link" href="{{ discordContactUrl }}" target="_blank" rel="noopener noreferrer">Open the official GOV.UH One Login Discord contact (opens in a new tab)</a></p>
      <p class="govuk-body">A Discord account is optional. Discord messages are not the authoritative record for confidential account or service decisions.</p>
    </section>
  {% endif %}

  {% if not contactEmailServiceEnabled and not contactEmailAddress and not contactDiscordEnabled %}
    <p class="govuk-body">Account support contact details have not yet been configured. Do not present this page as an operational support service.</p>
  {% endif %}

  <p class="govuk-body">You can read public information on GOV.UH without signing in.</p>
{% endblock %}
